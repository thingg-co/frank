# systemd user unit for frank's chat page (bin/frank --web), on the sessions the frank
# command keeps. Like the control page it is started by hand and needs no model: until a
# model server is up it says so on the page. It listens where PANEL_HOST says.
[Unit]
Description=frank chat page
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=@ROOT@/bin/frank --web
Restart=on-failure
RestartSec=5
Environment=PATH=@ROOT@/.tools/bin:%h/.local/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
